PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codealpha_store
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
# Set to true to also serve ../frontend from this server (single-command run)
SERVE_FRONTEND=true
